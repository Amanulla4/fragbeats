{
  "id": "/",
  "name": "FragBeats",
  "short_name": "FragBeats",
  "description": "Upload, discover, and share short gaming clips with a creator-first gaming community.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#040810",
  "theme_color": "#040810",
  "orientation": "portrait",
  "categories": ["games", "entertainment", "social", "video"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Explore Clips",
      "short_name": "Explore",
      "description": "Browse gaming clips",
      "url": "/explore",
      "icons": [
        {
          "src": "/favicon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Upload Clip",
      "short_name": "Upload",
      "description": "Upload your gaming clip",
      "url": "/upload",
      "icons": [
        {
          "src": "/favicon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Open Feed",
      "short_name": "Feed",
      "description": "Watch short gaming clips",
      "url": "/feed",
      "icons": [
        {
          "src": "/favicon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ]
}